            </div>
        </section>
        
        <section class="container">
            <div class="btn">
                <a href="https://www.twitch.tv/francolabs" target="_blank" rel="noopener noreferrer">
                    <div class="btn__imgContainer twitch">
                        <img src="../img/twitch.png" alt="Sígueme en Twitch - FrancoLabs streaming de programación">
                    </div>
                    <div class="btn__containerText">
                        <p class="btn__title">Twitch</p>
                        <p class="btn__text">Canal de Twitch de FrancoLabs</p>
                    </div>
                </a>
            </div>
            <div class="btn">
                <a href="https://www.tiktok.com/@francobalich?" target="_blank">
                    <div class="btn__imgContainer tiktok">
                        <img src="../img/tiktok.png" alt="Logo de TikTok">
                    </div>
                    <div class="btn__containerText">
                        <p class="btn__title">TikTok</p>
                        <p class="btn__text">Perfil de TikTok de Franco Balich</p>
                    </div>
                </a>
            </div>
            <div class="btn">
                <a href="https://www.instagram.com/francobalich/" target="_blank">
                    <div class="btn__imgContainer instagram">
                        <img src="../img/logotipo-de-instagram.png" alt="Logo de Instagram">
                    </div>
                    <div class="btn__containerText">
                        <p class="btn__title">Instagram</p>
                        <p class="btn__text">Perfil de Instagram de Franco Balich</p>
                    </div>
                </a>
            </div>
            <div class="btn">
                <a href="https://discord.com/invite/Pvj6ZH2FPf" target="_blank">
                    <div class="btn__imgContainer discord">
                        <img src="../img/discord.png" alt="Logo de Discord">
                    </div>
                    <div class="btn__containerText">
                        <p class="btn__title">Discord</p>
                        <p class="btn__text">Comunidad de Discord de InnovativaLab</p>
                    </div>
                </a>
            </div>
            <div class="btn">
                <a href="https://www.youtube.com/c/FrancoBalich" target="_blank">
                    <div class="btn__imgContainer youtube">
                        <img src="../img/youtube.png" alt="Logo de Youtube">
                    </div>
                    <div class="btn__containerText">
                        <p class="btn__title">YouTube</p>
                        <p class="btn__text">Canal de YouTube de Franco Balich</p>
                    </div>
                </a>
            </div>
            <div class="btn">
                <a href="https://github.com/francobalich" target="_blank">
                    <div class="btn__imgContainer github">
                        <img src="../img/github.png" alt="Logo de Github">
                    </div>
                    <div class="btn__containerText">
                        <p class="btn__title">GitHub</p>
                        <p class="btn__text">Perfil de GitHub de Franco Balich</p>
                    </div>
                </a>
            </div>
            <div class="btn">
                <a href="https://twitter.com/francobalich" target="_blank">
                    <div class="btn__imgContainer twitter">
                        <img src="../img/twitter.png" alt="Logo de Twitter">
                    </div>
                    <div class="btn__containerText">
                        <p class="btn__title">Twitter</p>
                        <p class="btn__text">Perfil de Twitter de Franco Balich</p>
                    </div>
                </a>
            </div>
            
        </section>
