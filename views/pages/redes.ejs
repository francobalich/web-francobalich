<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="UTF-8">
    <meta http-equiv="X-UA-Compatible" content="IE=edge">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    
    <!-- SEO Optimizado -->
    <title>Redes Sociales - Franco Balich | Sígueme en mis plataformas</title>
    <meta name="description" content="Sígueme en mis redes sociales para contenido sobre desarrollo Full Stack, Data Engineering, IoT y tecnología. Franco Balich en Twitch, LinkedIn, GitHub y más.">
    <meta name="keywords" content="Franco Balich redes sociales, Twitch francolabs, LinkedIn Franco Balich, GitHub desarrollo, contenido tecnología, streaming programación">
    <meta name="author" content="Franco Adrian Balich">
    <meta name="robots" content="index, follow">
    
    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website">
    <meta property="og:url" content="https://francobalich.com/redes">
    <meta property="og:title" content="Redes Sociales - Franco Balich | Contenido sobre Tecnología">
    <meta property="og:description" content="Sígueme en mis redes sociales para contenido sobre desarrollo Full Stack, Data Engineering, IoT y tecnología.">
    <meta property="og:image" content="../img/foto-de-perfil.png">

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image">
    <meta property="twitter:url" content="https://francobalich.com/redes">
    <meta property="twitter:title" content="Redes Sociales - Franco Balich">
    <meta property="twitter:description" content="Sígueme en mis redes sociales para contenido sobre desarrollo Full Stack, Data Engineering, IoT y tecnología.">
    <meta property="twitter:image" content="../img/foto-de-perfil.png">
    
    <!-- Canonical URL -->
    <link rel="canonical" href="https://francobalich.com/redes">
    
    <link rel="stylesheet" href="../css/stylesLink.css">
    <%- include('../partials/head.ejs'); %>
</head>
<body>
    <main>
        <section class="info">
            <div class="info__imgContainer">
                <img src="../img/foto-de-perfil.png" alt="Franco Balich - Director del Laboratorio Creativo 3D, perfil profesional">
            </div>
            <div class="btn__containerText">
                <h1 class="info__title">Franco Balich</h1>
                <h2 class="info__subtitle">Director del Laboratorio Creativo 3D, Doctorando en Informática, Full Stack Developer, Data Engineer y creador de contenido sobre tecnología.</h2>
