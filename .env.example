# Payload CMS
PAYLOAD_SECRET=genera-una-clave-secreta-aleatoria-aqui

# Supabase PostgreSQL
# Settings > Database > Connection String (Transaction pooler)
DATABASE_URL=postgresql://postgres.[project-id]:[password]@aws-0-[region].pooler.supabase.com:6543/postgres?sslmode=require

# Supabase Storage (S3-compatible)
# Storage > S3 Credentials en el dashboard de Supabase
S3_BUCKET=media
S3_ACCESS_KEY_ID=tu-access-key
S3_SECRET_ACCESS_KEY=tu-secret-key
S3_REGION=us-east-1
S3_ENDPOINT=https://[project-id].supabase.co/storage/v1/s3
